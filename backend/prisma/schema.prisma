generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id          BigInt    @id @default(autoincrement())
  tags        String[]  @default([])
  tagMode     String    @default("auto")
  title       String    @db.VarChar(255)
  done        Boolean   @default(false)
  important   Boolean   @default(false)
  carriedOver Boolean   @default(false)
  day         DateTime  @db.Date
  page        TodoDay   @relation(fields: [day], references: [date], onDelete: Cascade)
  deletedAt   DateTime? @db.Timestamp(3)

  @@index([day, done, important, id])
  @@index([deletedAt])
  @@map("todos")
}

model TodoDay {
  activated  Boolean  @default(true)
  date       DateTime @id @db.Date
  reviewNote String?  @db.VarChar(500)
  todos      Todo[]

  @@map("todo_days")
}

model Routine {
  id           String   @id @default(cuid())
  tags         String[] @default([])
  tagMode      String   @default("auto")
  title        String   @db.VarChar(255)
  enabled      Boolean  @default(true)
  daysOfWeek   String[] @default([])
  intervalDays Int      @default(1)
  startDate    String?  @db.VarChar(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  history      RoutineHistory[]

  @@map("routines")
}

model RoutineHistory {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dateKey   String   @db.VarChar(10)
  todoId    BigInt
  createdAt DateTime @default(now())

  @@unique([routineId, dateKey])
  @@index([dateKey])
  @@map("routine_history")
}