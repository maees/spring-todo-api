{
  "name": "bun-todo-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:baseline": "prisma migrate resolve --applied 20261017000000_init",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^16.6.1",
    "hono": "^4.13.13",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}